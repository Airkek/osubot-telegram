topic-telegram-only = Topic settings are only available in Telegram groups.
topic-admin-required = Only group administrators can change topic settings.
topic-unknown = not in a topic
topic-none = none
topic-status =
    Current topic ID: {$topic}
    Topics where the bot is disabled: {$blocked}
    Use “/topicbot deny [topic_id]” or “/topicbot allow [topic_id]”. Without an ID, the current topic is used.
topic-usage = Use “/topicbot deny [topic_id]”, “/topicbot allow [topic_id]”, or “/topicbot list”.
topic-id-required = Provide a topic ID or run this command inside the topic.
topic-invalid-id = Invalid topic ID. It must be a positive integer.
topic-state-enabled = enabled
topic-state-disabled = disabled
topic-updated = Bot replies in topic {$topic} are now {$state}. Use /topicbot allow or /topicbot deny to change this.
